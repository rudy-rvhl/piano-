    "react-router-dom": "^6.26.2",
    "tone": "^15.0.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/webmidi": "^2.0.10",
